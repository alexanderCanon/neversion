{
  "name": "neversion",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'pnpm-lock.yaml' -type f -delete",
    "build": "pnpm -r build",
    "api:sync": "openapi-generator-cli generate -i ${API_URL:-http://localhost:8080/v3/api-docs} -g typescript-angular -o packages/api-client/src --additional-properties=providedInRoot=true,serviceSuffix=ApiService,apiModulePrefix=Neversion",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@eslint/js": "^9.39.4",
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.4",
    "supabase": "^2.111.0",
    "tslib": "^2.3.0",
    "typescript-eslint": "8.46.4"
  }
}
