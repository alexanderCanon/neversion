# Strictly isolate dependencies to prevent version cross-contamination
shamefully-hoist=false

# Prevent any @angular or @supabase hoisting to the root
public-hoist-pattern[]=[]

# Force each package to resolve its own dependencies from its local node_modules
auto-install-peers=true
dedupe-peer-dependents=false

# GitHub Packages scoped registry
@alexandercanon:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
