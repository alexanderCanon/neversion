# ══════════════════════════════════════════════════════════════════
# Environment Variables Template — Infrastructure
#
# Copy this file to .env and fill in your values:
#   cp infra/.env.example infra/.env
#
# NEVER commit the .env file to version control!
# ══════════════════════════════════════════════════════════════════

# Database (PostgreSQL) ──────────────────────────────────────────
POSTGRES_DB=neversiondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# Authentication ─────────────────────────────────────────
# JWT secret for token signing (must be 256-bit or more for HS256)
AUTH_JWT_SECRET=your-dev-jwt-secret-must-be-long-enough-for-hs256-signing
