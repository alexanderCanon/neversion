# ══════════════════════════════════════════════════════════════════
# Environment Variables Template — Neversion API
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# docker-compose.prod.yaml reads these automatically.
# NEVER commit the .env file to version control!
# ══════════════════════════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/YOUR_DATABASE
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# ── Supabase Auth ─────────────────────────────────────────────────
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ── Server ────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Email — Resend (EPIC-08) ─────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
NEVERSION_EMAIL_FROM=Neversion <noreply@yourdomain.com>

# ── Cron Jobs ─────────────────────────────────────────────────────
# Notification Worker: processes pending emails every N ms
NEVERSION_CRON_NOTIFICATION_WORKER_ENABLED=true
NEVERSION_CRON_NOTIFICATION_WORKER_INTERVAL_MS=30000

# Renewal Reminders: sends 7d/3d/1d reminders daily at 08:00
NEVERSION_CRON_RENEWAL_REMINDERS_ENABLED=true

# Subscription Expiry: suspends overdue subscriptions daily at 02:00
NEVERSION_CRON_SUBSCRIPTION_EXPIRY_ENABLED=true

# ── Business Rules ────────────────────────────────────────────────
# Grace period (days) for late renewals before recalculating from today
NEVERSION_RENEWAL_GRACE_PERIOD_DAYS=2

# ── Grafana (optional — change defaults after first login) ────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
