# ══════════════════════════════════════════════════════════════════
# Environment Variables Template — Production
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# docker-compose.prod.yaml reads these automatically.
# NEVER commit the .env file to version control!
# ══════════════════════════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/YOUR_DATABASE
SPRING_DATASOURCE_USERNAME=YOUR_DB_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# ── Supabase Auth ─────────────────────────────────────────────────
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Grafana (optional — change defaults after first login) ────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
