# ══════════════════════════════════════════════════════════════════
# Environment Variables Template — Neversion API
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ══════════════════════════════════════════════════════════════════

# ACTIVE PROFILE ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# SERVER ──────────────────────────────────────────────────────────
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://panel.yourdomain.com,https://store.yourdomain.com

# DATABASE ────────────────────────────────────────────────────────
# If using a connection pooler like PgBouncer in transaction mode, append
# ?preparedStatementCacheQueries=0&preparedStatementCacheSizeMiB=0 to the URL.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_HOST:5432/neversiondb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# AUTHENTICATION & GATEWAY ─────────────────────────────────────────
# Secret key attached as X-Gateway-Secret by Cloudflare Worker
NEVERSION_GATEWAY_SECRET=your_gateway_secret_here
# URL of the self-hosted authentication service (e.g. GoTrue API)
AUTH_API_URL=http://localhost:9999
# Service/Admin secret key used to execute high-privilege operations
AUTH_ADMIN_KEY=your_auth_service_admin_key

# CLOUDFLARE TUNNEL ────────────────────────────────────────────────
# Option A: Cloudflare Tunnel Token (from Zero Trust Dashboard)
CLOUDFLARED_TUNNEL_TOKEN=ey...
# Option B: Tunnel Name or UUID (if using local credentials file ~/.cloudflared/ID.json)
CLOUDFLARED_TUNNEL_ID=dcde1649-2238-441b-acc4-309c6afb8ab5

# BUSINESS RULES & CRON SCHEDULING ────────────────────────────────
# Grace period (days) for late renewals before recalculating from today
NEVERSION_RENEWAL_GRACE_PERIOD_DAYS=2
# Suspends overdue subscriptions daily
NEVERSION_CRON_SUBSCRIPTION_EXPIRY_ENABLED=true
# Cron expression (minute hour day month day-of-week). Default: daily at 08:00
NEVERSION_CRON_SUBSCRIPTION_EXPIRY_SCHEDULE=0 0 8 * * *
# Sends renewal notifications
NEVERSION_CRON_RENEWAL_REMINDERS_ENABLED=true

# NOTIFICATION SERVICE (gRPC) ────────────────────────────────────
NEVERSION_NOTIFICATION_SERVICE_HOST=notification-service
NEVERSION_NOTIFICATION_SERVICE_PORT=50051
