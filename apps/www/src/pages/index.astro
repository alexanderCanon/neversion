---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ForClients from '../components/ForClients.astro';
import ForVendors from '../components/ForVendors.astro';
import TechArchitecture from '../components/TechArchitecture.astro';
import PhilosophyStory from '../components/PhilosophyStory.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Neversion — El panel que te avisa antes de perder una renovación"
  description="Neversion es la plataforma para vender y comprar suscripciones, gift cards y recargas — con tienda propia por vendedor, panel de renovaciones y arquitectura serverless-first."
>
  <Navbar />
  <main>
    <Hero />
    <ForClients />
    <ForVendors />
    <TechArchitecture />
    <PhilosophyStory />
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
