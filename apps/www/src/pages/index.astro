<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neversion — El panel que te avisa antes de perder una renovación</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink: #111B2D;
    --surface: #1e293b;
    --surface-2: #1e293b;
    --border: rgba(255, 255, 255, 0.08);
    --text: #f8fafc;
    --text-muted: #94a3b8;
    --brand-accent: #1d4ed8;
    --brand-accent-light: #60a5fa;
    --danger: #e11d48;
    --success: #059669;
    --warning: #d97706;

    --display: 'Inter', system-ui, -apple-system, sans-serif;
    --body: 'Inter', system-ui, -apple-system, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;

    --max: 1120px;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }

  html{ scroll-behavior: smooth; }

  body{
    background: var(--ink);
    color: var(--text);
    font-family: var(--body);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  img, svg{ display:block; max-width:100%; }

  a{ color: inherit; text-decoration: none; }

  .wrap{ max-width: var(--max); margin: 0 auto; padding: 0 24px; }

  .eyebrow{
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-accent-light);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .eyebrow::before{
    content:'';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--brand-accent-light);
    box-shadow: 0 0 0 3px rgba(96,165,250,0.18);
  }

  h1, h2, h3{ font-family: var(--display); font-weight: 600; letter-spacing: -0.01em; }

  /* ---------- NAV ---------- */
  header.nav{
    position: sticky; top:0; z-index: 50;
    background: rgba(17,27,45,0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding: 18px 24px;
  }
  .logo{
    font-family: var(--display); font-weight: 700; font-size: 1.15rem;
    display:flex; align-items:center; gap:8px;
  }
  .logo-mark{
    width: 22px; height: 22px;
    flex-shrink:0;
  }
  .nav-links{ display:flex; gap: 32px; }
  .nav-links a{
    font-size: 0.92rem; color: var(--text-muted);
    transition: color .15s ease;
  }
  .nav-links a:hover{ color: var(--text); }
  .nav-cta{
    font-size: 0.88rem; font-weight: 500;
    padding: 9px 18px; border-radius: 8px;
    background: var(--text); color: var(--ink);
    transition: opacity .15s ease;
  }
  .nav-cta:hover{ opacity: 0.85; }
  .nav-toggle{ display:none; }

  /* ---------- HERO ---------- */
  .hero{
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--border);
  }
  .hero-grid{
    display:grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items:center;
  }
  .hero h1{
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    margin-bottom: 22px;
  }
  .hero h1 .accent{ color: var(--brand-accent-light); }
  .hero p.lede{
    font-size: 1.08rem; color: var(--text-muted);
    max-width: 46ch; margin-bottom: 34px;
  }
  .cta-group{ display:flex; gap: 14px; flex-wrap: wrap; }
  .btn-primary{
    font-family: var(--body); font-weight: 600; font-size: 0.95rem;
    padding: 13px 24px; border-radius: 9px;
    background: var(--brand-accent); color: #ffffff;
    transition: transform .15s ease, box-shadow .15s ease, background-color .15s ease;
  }
  .btn-primary:hover{ background: #1e40af; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(29, 78, 216, 0.25); }
  .btn-secondary{
    font-family: var(--body); font-weight: 500; font-size: 0.95rem;
    padding: 13px 22px; border-radius: 9px;
    border: 1px solid var(--border); color: var(--text);
    transition: border-color .15s ease, background .15s ease;
  }
  .btn-secondary:hover{ border-color: var(--text-muted); background: var(--surface); }

  /* ---- signature element: renewal timeline ---- */
  .timeline-card{
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px 24px 22px;
  }
  .timeline-head{
    display:flex; justify-content: space-between; align-items:baseline;
    margin-bottom: 26px;
  }
  .timeline-head span.label{ font-size: 0.82rem; color: var(--text-muted); }
  .timeline-head span.month{ font-family: var(--mono); font-size: 0.82rem; color: var(--text-muted); }

  .timeline{
    position: relative;
    height: 6px;
    background: var(--surface-2);
    border-radius: 4px;
    margin: 0 4px 30px;
  }
  .t-fill{
    position:absolute; left:0; top:0; height:100%;
    width: 62%;
    background: linear-gradient(90deg, var(--brand-accent), var(--brand-accent-light));
    border-radius: 4px;
  }
  .t-dot{
    position:absolute; top:50%; transform: translate(-50%,-50%);
    width: 13px; height: 13px; border-radius: 50%;
    border: 2px solid var(--ink);
  }
  .t-dot.done{ background: var(--brand-accent); left: 14%; }
  .t-dot.done2{ background: var(--brand-accent); left: 36%; }
  .t-dot.now{
    background: var(--brand-accent-light); left: 62%;
    width: 16px; height: 16px;
    box-shadow: 0 0 0 4px rgba(96,165,250,0.22);
    animation: pulse 2.2s ease-in-out infinite;
  }
  .t-dot.pending{ background: var(--surface-2); border-color: var(--border); left: 84%; }

  @keyframes pulse{
    0%, 100%{ box-shadow: 0 0 0 4px rgba(96,165,250,0.22); }
    50%{ box-shadow: 0 0 0 8px rgba(96,165,250,0.10); }
  }

  .status-rows{ display:flex; flex-direction:column; gap: 11px; }
  .status-row{
    display:flex; align-items:center; justify-content: space-between;
    font-size: 0.85rem;
    padding: 10px 12px;
    background: var(--surface-2);
    border-radius: 8px;
  }
  .status-row .client{ color: var(--text); font-weight: 500; }
  .status-row .date{ font-family: var(--mono); color: var(--text-muted); font-size: 0.8rem; }
  .badge{
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.03em;
    padding: 3px 9px; border-radius: 20px;
    text-transform: uppercase;
  }
  .badge.activa{ background: rgba(5, 150, 105, 0.12); color: var(--success); }
  .badge.pronto{ background: rgba(217, 119, 6, 0.14); color: var(--warning); }
  .badge.vencida{ background: rgba(225, 29, 72, 0.14); color: var(--danger); }

  /* ---------- SECTION SHARED ---------- */
  section{ padding: 88px 0; border-bottom: 1px solid var(--border); }
  .section-head{ max-width: 640px; margin-bottom: 48px; }
  .section-head h2{ font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: 16px; }
  .section-head p{ color: var(--text-muted); font-size: 1.02rem; }

  /* ---------- PROBLEM ---------- */
  .problem-body{ display:grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items:start; }
  .problem-body p{ color: var(--text-muted); font-size: 1.02rem; margin-bottom: 18px; }
  .problem-body p strong{ color: var(--text); font-weight: 600; }

  .chaos-card{
    background: var(--surface); border:1px solid var(--border); border-radius: 14px;
    padding: 22px;
  }
  .chaos-card .chaos-title{ font-family: var(--mono); font-size: 0.78rem; color: var(--text-muted); margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.06em;}
  .chaos-line{ display:flex; align-items:center; gap: 10px; font-size: 0.88rem; color: var(--text-muted); padding: 8px 0; border-bottom: 1px dashed var(--border); }
  .chaos-line:last-child{ border-bottom:none; }
  .chaos-line .dot{ width:6px; height:6px; border-radius:50%; background: var(--danger); flex-shrink:0; }

  /* ---------- SOLUTION / PANEL MOCK ---------- */
  .solution-grid{ display:grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items:center; }
  .solution-grid .section-head{ margin-bottom: 0; }

  .panel-mock{
    background: var(--surface); border:1px solid var(--border); border-radius: 16px;
    overflow:hidden;
  }
  .panel-mock-head{
    display:flex; align-items:center; gap:8px;
    padding: 14px 18px; border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .panel-mock-head span{ width:9px; height:9px; border-radius:50%; background: var(--border); }
  .panel-mock-head .fname{ font-family: var(--mono); font-size: 0.76rem; color: var(--text-muted); margin-left: 8px; }
  .panel-table{ width:100%; border-collapse: collapse; }
  .panel-table th{
    text-align:left; font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase;
    color: var(--text-muted); letter-spacing: 0.05em;
    padding: 12px 18px; border-bottom: 1px solid var(--border);
    background-color: var(--surface-2);
  }
  .panel-table td{
    padding: 13px 18px; font-size: 0.86rem; border-bottom: 1px solid var(--border);
  }
  .panel-table tr:last-child td{ border-bottom: none; }
  .panel-table td.mono{ font-family: var(--mono); color: var(--text-muted); font-size: 0.8rem; }

  /* ---------- FEATURES ---------- */
  .features-grid{ display:grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .feature-card{
    background: var(--surface); border:1px solid var(--border); border-radius: 14px;
    padding: 26px 22px;
    transition: border-color .15s ease, transform .15s ease;
  }
  .feature-card:hover{ border-color: var(--text-muted); transform: translateY(-2px); }
  .feature-card .f-badge{
    width: 34px; height: 34px; border-radius: 9px;
    display:flex; align-items:center; justify-content:center;
    margin-bottom: 18px; font-family: var(--mono); font-size: 0.85rem; font-weight: 500;
  }
  .feature-card:nth-child(1) .f-badge{ background: rgba(217,119,6,0.14); color: var(--warning); }
  .feature-card:nth-child(2) .f-badge{ background: rgba(5,150,105,0.14); color: var(--success); }
  .feature-card:nth-child(3) .f-badge{ background: rgba(225,29,72,0.14); color: var(--danger); }
  .feature-card:nth-child(4) .f-badge{ background: rgba(29,78,216,0.14); color: var(--brand-accent-light); }
  .feature-card h3{ font-size: 1.02rem; margin-bottom: 10px; }
  .feature-card p{ color: var(--text-muted); font-size: 0.88rem; }

  /* ---------- HOW IT WORKS ---------- */
  .how-list{ display:flex; flex-direction:column; }
  .how-item{
    display:grid; grid-template-columns: 64px 1fr; gap: 22px;
    padding: 26px 0; border-top: 1px solid var(--border);
  }
  .how-item:last-child{ border-bottom: 1px solid var(--border); }
  .how-num{ font-family: var(--mono); font-size: 0.95rem; color: var(--brand-accent-light); }
  .how-item h3{ font-size: 1.05rem; margin-bottom: 6px; }
  .how-item p{ color: var(--text-muted); font-size: 0.92rem; max-width: 56ch; }

  /* ---------- CONTACT ---------- */
  .contact{ border-bottom:none; padding-bottom: 56px; }
  .contact-inner{
    background: linear-gradient(135deg, var(--surface), var(--surface-2));
    border: 1px solid var(--border); border-radius: 20px;
    padding: 56px 48px;
    display:flex; align-items:center; justify-content:space-between; gap: 32px;
    flex-wrap: wrap;
  }
  .contact-inner h2{ font-size: clamp(1.5rem, 2.6vw, 2rem); margin-bottom: 10px; max-width: 24ch;}
  .contact-inner p{ color: var(--text-muted); max-width: 42ch; }
  .contact-cta{ display:flex; gap: 14px; flex-wrap: wrap; }

  /* ---------- FOOTER ---------- */
  footer{ padding: 32px 0 40px; }
  .footer-inner{
    display:flex; align-items:center; justify-content:space-between; flex-wrap: wrap; gap: 16px;
  }
  .footer-left{ font-size: 0.82rem; color: var(--text-muted); }
  .footer-stack{
    font-family: var(--mono); font-size: 0.76rem; color: var(--text-muted);
    display:flex; align-items:center; gap: 10px; flex-wrap: wrap;
  }
  .footer-stack a{ color: var(--text-muted); border-bottom: 1px dotted var(--border); transition: color .15s ease; }
  .footer-stack a:hover{ color: var(--text); }
  .footer-links{ display:flex; gap: 18px; }
  .footer-links a{ font-size: 0.82rem; color: var(--text-muted); transition: color .15s ease; }
  .footer-links a:hover{ color: var(--text); }

  /* ---------- REVEAL ---------- */
  .reveal{ opacity: 0; transform: translateY(14px); transition: opacity .6s ease, transform .6s ease; }
  .reveal.in{ opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    .reveal{ opacity:1; transform:none; transition:none; }
    .t-dot.now{ animation: none; }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 880px){
    .hero-grid, .problem-body, .solution-grid{ grid-template-columns: 1fr; }
    .features-grid{ grid-template-columns: repeat(2, 1fr); }
    .nav-links{ display:none; }
    .contact-inner{ padding: 36px 26px; }
  }
  @media (max-width: 560px){
    .features-grid{ grid-template-columns: 1fr; }
    .how-item{ grid-template-columns: 40px 1fr; }
    section{ padding: 64px 0; }
    .hero{ padding: 64px 0 48px; }
    .contact-inner{ flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#" class="logo">
