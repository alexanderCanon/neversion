---
// src/components/ContactSection.astro
---

<section id="contacto" class="contact">
  <div class="wrap">
    <div class="contact-card reveal">
      <div class="contact-text">
        <span class="eyebrow">Contacto & Colaboración</span>
        <h2>¿Quieres operar tu tienda o conocer el sistema a fondo?</h2>
        <p>
          Ya sea que busques digitalizar tu negocio de suscripciones o quieras conversar sobre la arquitectura técnica y posibles sinergias, hablemos directamente.
        </p>
      </div>

      <div class="contact-actions">
        <a href="https://www.linkedin.com/in/alexcanon64" target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          <span>Conectar en LinkedIn</span>
        </a>
        <a href="https://github.com/alexanderCanon/neversion" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span>Explorar en GitHub</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 88px 0;
  }

  .contact-card {
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-2) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 56px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .contact-text {
    max-width: 580px;
  }

  .contact-text h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    margin-bottom: 14px;
    color: var(--text);
  }

  .contact-text p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .contact-actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .contact-card {
      padding: 36px 28px;
      flex-direction: column;
      align-items: flex-start;
    }
    .contact-actions {
      width: 100%;
    }
    .contact-actions a {
      justify-content: center;
    }
  }
</style>
